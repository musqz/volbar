def show_once(args):
    """Show volume bar once and exit"""
    backend = AudioBackend.detect()
    if not backend:
        print("✗ No audio backend found (wpctl, pactl, or amixer)")
        sys.exit(1)
    
    volume, muted = backend()
    
    if args['debug']:
        print(f"Backend detected, volume: {volume}%, muted: {muted}")
    
    window = VolumeWindow(
        size=args['size'],
        placement=args['placement'],
        show_icon=args['icon'],
        show_percent=args['percent'],
        slider=args['slider'],
        theme=args['theme'],
        debug=args['debug']
    )
    
    window.show_all()
    
    while Gtk.events_pending():
        Gtk.main_iteration_do(False)
    
    window.update(volume, muted)
    
    GLib.timeout_add(args['timeout'], lambda: (window.hide(), Gtk.main_quit()))
    
    try:
        Gtk.main()
    except KeyboardInterrupt:
        window.hide()
        sys.exit(0)


class TrayIcon:
    ICONS = {
        'muted': 'audio-volume-muted',
        'low': 'audio-volume-low',
        'medium': 'audio-volume-medium',
        'high': 'audio-volume-high',
    }

    def __init__(self, backend, window, step, mixer, cleanup_callback=None):
        self.backend = backend
        self.window = window
        self.step = step
        self.mixer = mixer
        self.cleanup_callback = cleanup_callback

        self.icon = Gtk.StatusIcon()
        self.icon.set_visible(True)

        self.icon.connect("scroll-event", self.on_scroll)
        self.icon.connect("button-press-event", self.on_click)

        self.menu = self.build_menu()
        GLib.timeout_add(400, self.refresh_icon)

    def cleanup(self):
        """Properly cleanup the tray icon before exit"""
        self.icon.set_visible(False)
        # Give tint2/panel time to process the icon removal
        for _ in range(3):
            while Gtk.events_pending():
                Gtk.main_iteration_do(False)
            time.sleep(0.05)

    def build_menu(self):
        menu = Gtk.Menu()

        mixer_item = Gtk.MenuItem(label="Open Mixer")
        quit_item = Gtk.MenuItem(label="Quit")

        mixer_item.connect(
            "activate",
            lambda *_: subprocess.Popen(self.mixer.split(),
                                        stdout=subprocess.DEVNULL,
                                        stderr=subprocess.DEVNULL)
        )
        
        # Call cleanup callback on quit
        quit_item.connect("activate", self.on_quit)

        menu.append(mixer_item)
        menu.append(Gtk.SeparatorMenuItem())
        menu.append(quit_item)
        menu.show_all()
        return menu

    def on_quit(self, *_):
        """Handle quit from menu - use idle_add for clean exit"""
        # Schedule quit on idle to let GTK finish processing menu
        GLib.idle_add(self._do_quit)
    
    def _do_quit(self):
        """Actually quit after cleanup"""
        if self.cleanup_callback:
            self.cleanup_callback()
        else:
            # Fallback if no callback - clean up ourselves
            self.cleanup()
            Gtk.main_quit()
        return False

    def on_scroll(self, icon, event):
        if event.direction == Gdk.ScrollDirection.UP:
            AudioControl.volume_up(self.step)
        elif event.direction == Gdk.ScrollDirection.DOWN:
            AudioControl.volume_down(self.step)

        GLib.timeout_add(50, self.show_osd)

    def on_click(self, icon, event):
        if event.button == 3:
            self.menu.popup_at_pointer(event)
        elif event.button in (1, 2):
            AudioControl.toggle_mute()
            GLib.timeout_add(50, self.show_osd)

    def show_osd(self):
        volume, muted = self.backend()
        self.window.update(volume, muted)
        if not self.window.is_visible():
            self.window.show_all()
        return False

    def refresh_icon(self):
        volume, muted = self.backend()

        if muted:
            icon = self.ICONS['muted']
        elif volume <= 30:
            icon = self.ICONS['low']
        elif volume <= 70:
            icon = self.ICONS['medium']
        else:
            icon = self.ICONS['high']

        self.icon.set_from_icon_name(icon)
        self.icon.set_tooltip_text(
            "Muted" if muted else f"Volume: {volume}%"
        )
        return True


def run_daemon(args):
    """Run as daemon"""
    existing_pid = check_daemon_running()
    if existing_pid:
        print(f"✗ Daemon already running (PID: {existing_pid})")
        sys.exit(1)

    create_pid_file()

    backend = AudioBackend.detect()
    if not backend:
        print("✗ No audio backend found (wpctl, pactl, or amixer)")
        remove_pid_file()
        sys.exit(1)

    window = VolumeWindow(
        size=args['size'],
        placement=args['placement'],
        show_icon=args['icon'],
        show_percent=args['percent'],
        slider=args['slider'],
        theme=args['theme'],
        debug=args['debug']
    )

    # State variables for volume tracking and OSD
    last_volume = -1
    last_muted = False
    hide_timeout = None
    tray = None
    
    # Track if cleanup already ran
    cleanup_done = False

    # Cleanup function for GLib signal handler
    def cleanup(*_):
        nonlocal cleanup_done
        if cleanup_done:
            return False
        cleanup_done = True
        
        if args['debug']:
            print(f"\nShutting down...")
        
        # Clean up tray icon first
        if tray:
            tray.cleanup()
        
        # Hide window
        window.hide()
        
        # Process pending events
        while Gtk.events_pending():
            Gtk.main_iteration_do(False)
        
        remove_pid_file()
        
        # Quit main loop if running
        if Gtk.main_level() > 0:
            Gtk.main_quit()
        
        return False

    # Initialize tray icon if requested
    if args.get('systray'):
        tray = TrayIcon(
            backend=backend,
            window=window,
            step=args['tray_step'],
            mixer=args['mixer'],
            cleanup_callback=cleanup
        )

    # Volume polling function
    def check_volume():
        nonlocal last_volume, last_muted, hide_timeout

        volume, muted = backend()

        if volume != last_volume or muted != last_muted:
            last_volume = volume
            last_muted = muted

            if args['debug']:
                print(f"Volume changed: {volume}%, muted: {muted}")

            if not window.is_visible():
                window.show_all()
                while Gtk.events_pending():
                    Gtk.main_iteration_do(False)

            window.update(volume, muted)

            if hide_timeout:
                GLib.source_remove(hide_timeout)
            hide_timeout = GLib.timeout_add(
                args['timeout'], lambda: window.hide()
            )

        return True

    # Use only GLib.unix_signal_add for GTK-safe signal handling
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, cleanup)
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, cleanup)

    # Poll volume every poll_interval milliseconds
    GLib.timeout_add(args['poll_interval'], check_volume)

    print(f"✓ Volbar daemon started (PID: {os.getpid()})")
    print(f"  Stop with: volbar --stop-daemon")

    try:
        Gtk.main()
    except KeyboardInterrupt:
        cleanup()
    
    # Final cleanup if not done
    if not cleanup_done:
        cleanup()
    
    sys.exit(0)



def main():
    args = parse_args()
    
    if args['mode'] == 'daemon':
        run_daemon(args)
    else:
        show_once(args)


if __name__ == '__main__':
    main()
