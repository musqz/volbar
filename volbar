class AudioBackend:
    """Detect and use available audio backend"""
    
    @staticmethod
    def detect():
        backends = [
            ('wpctl', AudioBackend.wpctl),
            ('pactl', AudioBackend.pactl),
            ('amixer', AudioBackend.amixer)
        ]
        
        for cmd, handler in backends:
            if subprocess.run(['which', cmd], capture_output=True).returncode == 0:
                return cmd, handler
        return None, None
    
    @staticmethod
    def wpctl():
        try:
            result = subprocess.run(['wpctl', 'get-volume', '@DEFAULT_SINK@'],
                                  capture_output=True, text=True, check=True, timeout=0.5)
            parts = result.stdout.strip().split()
            volume = int(float(parts[1]) * 100)
            muted = '[MUTED]' in result.stdout
            return volume, muted
        except Exception:
            return 0, False
    
    @staticmethod
    def pactl():
        try:
            mute_result = subprocess.run(['pactl', 'get-sink-mute', '@DEFAULT_SINK@'],
                                        capture_output=True, text=True, check=True, timeout=0.5)
            muted = 'yes' in mute_result.stdout
            
            vol_result = subprocess.run(['pactl', 'get-sink-volume', '@DEFAULT_SINK@'],
                                       capture_output=True, text=True, check=True, timeout=0.5)
            for line in vol_result.stdout.split('\n'):
                if '%' in line:
                    volume = int(line.split('%')[0].split()[-1])
                    return volume, muted
            return 0, muted
        except Exception:
            return 0, False
    
    @staticmethod
    def amixer():
        try:
            result = subprocess.run(['amixer', 'get', 'Master'],
                                  capture_output=True, text=True, check=True, timeout=0.5)
            for line in result.stdout.split('\n'):
                if '%' in line and '[' in line:
                    volume = int(line.split('[')[1].split('%')[0])
                    muted = '[off]' in line
                    return volume, muted
            return 0, False
        except Exception:
            return 0, False


class AudioControl:
    """Backend-aware volume controls"""
    @staticmethod
    def volume_up(step):
        cmd_name, handler = AudioBackend.detect()
        if not cmd_name: return
        try:
            if cmd_name == 'wpctl':
                vol, _ = handler()
                new_vol = min(vol + step, 100)
                subprocess.run(['wpctl', 'set-volume', '@DEFAULT_SINK@', f'{new_vol}%'], 
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)
            elif cmd_name == 'pactl':
                subprocess.run(['pactl', 'set-sink-volume', '@DEFAULT_SINK@', f'+{step}%'], 
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)
            elif cmd_name == 'amixer':
                subprocess.run(['amixer', 'set', 'Master', f'{step}%+'], 
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)
        except subprocess.TimeoutExpired:
            pass

    @staticmethod
    def volume_down(step):
        cmd_name, handler = AudioBackend.detect()
        if not cmd_name: return
        try:
            if cmd_name == 'wpctl':
                vol, _ = handler()
                new_vol = max(vol - step, 0)
                subprocess.run(['wpctl', 'set-volume', '@DEFAULT_SINK@', f'{new_vol}%'], 
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)
            elif cmd_name == 'pactl':
                subprocess.run(['pactl', 'set-sink-volume', '@DEFAULT_SINK@', f'-{step}%'], 
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)
            elif cmd_name == 'amixer':
                subprocess.run(['amixer', 'set', 'Master', f'{step}%-'], 
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)
        except subprocess.TimeoutExpired:
            pass

    @staticmethod
    def toggle_mute():
        cmd_name, _ = AudioBackend.detect()
        if not cmd_name: return
        try:
            if cmd_name == 'wpctl':
                subprocess.run(['wpctl', 'set-mute', '@DEFAULT_SINK@', 'toggle'], 
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)
            elif cmd_name == 'pactl':
                subprocess.run(['pactl', 'set-sink-mute', '@DEFAULT_SINK@', 'toggle'], 
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)
            elif cmd_name == 'amixer':
                subprocess.run(['amixer', 'set', 'Master', 'toggle'], 
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=0.5)
        except subprocess.TimeoutExpired:
            pass


