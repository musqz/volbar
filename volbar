# ============================================================================

class ThemeLoader:
    """Load CSS from ~/.config/volbar/themes, system themes, or auto-generate"""
    
    # Mabox conky config (better contrast colors from wallpaper)
    CONKY_PATH = Path.home() / '.config' / 'conky' / 'sysinfo_mbcolor.conkyrc'
    
    DEFAULT_CSS = """
/* Volbar Default Theme */

#volbar-container {
    background-color: rgba(43, 48, 59, 0.95);
    border: 3px solid #4f5b66;
    border-radius: 3px;
}

#volbar-container label {
    color: #c0c5ce;
}

label#icon {
    color: #c0c5ce;
    font-size: 18px;
    min-width: 30px;
}

label#icon.muted {
    color: #bf616a;
}

label#slider {
    color: #8fa1b3;
    font-family: monospace;
    letter-spacing: 0;
}

label#slider.muted {
    color: #bf616a;
}

label#percentage {
    color: #c0c5ce;
}

label#percentage.muted {
    color: #bf616a;
}
"""

    @staticmethod
    def parse_conky_colors():
        """Parse Mabox conky config for wallpaper-derived colors"""
        if not ThemeLoader.CONKY_PATH.exists():
            return None
        
        colors = {}
        try:
            content = ThemeLoader.CONKY_PATH.read_text()
            
            # Parse Lua-style config: key = 'value' or key = '#hex'
            patterns = {
                'bg': r"own_window_colour\s*=\s*['\"]?(#[0-9a-fA-F]{6})",
                'fg': r"default_color\s*=\s*['\"]?(#[0-9a-fA-F]{6})",
                'accent': r"color2\s*=\s*['\"]?(#[0-9a-fA-F]{6})",
                'secondary': r"color1\s*=\s*['\"]?(#[0-9a-fA-F]{6})",
            }
            
            for key, pattern in patterns.items():
                match = re.search(pattern, content)
                if match:
                    colors[key] = match.group(1)
            
            return colors if colors else None
        except Exception:
            return None

    @staticmethod
    def generate_auto_theme():
        """Generate CSS from Mabox conky wallpaper colors"""
        c = ThemeLoader.parse_conky_colors()
        if not c:
            return None
        
        # Extract colors with fallbacks
        bg = c.get('bg', '#1a1a1a')
        fg = c.get('fg', '#e0e0e0')
        accent = c.get('accent', c.get('fg', '#ff9900'))
        muted_color = '#bf616a'
        
        return f"""/* Auto-generated from Mabox conky wallpaper colors */

#volbar-container {{
    background-color: {bg};
    border: 3px solid {accent};
}}

#volbar-container label {{
    color: {fg};
}}

label#icon {{
    color: {accent};
    font-size: 18px;
    min-width: 30px;
}}

label#icon.muted {{
    color: {muted_color};
}}

label#slider {{
    color: {accent};
    font-family: monospace;
    letter-spacing: 0;
}}

label#slider.muted {{
    color: {muted_color};
}}

label#percentage {{
    color: {fg};
}}

label#percentage.muted {{
    color: {muted_color};
}}
"""
    
    @staticmethod
    def strip_border_radius(css):
        """Remove border-radius from CSS to let picom handle corners"""
        return re.sub(r'border-radius\s*:\s*[^;]+;', '', css)
    
    @staticmethod
    def load(theme_name='default'):
        """Load CSS theme from file, auto-generate, or use default"""
        
        # Handle 'auto' theme - generate from wallpaper colors
        if theme_name == 'auto':
            css = ThemeLoader.generate_auto_theme()
            if css:
                return ThemeLoader.strip_border_radius(css)
            # Fall back to default if colorrc not available
            print("⚠ Auto theme: colorrc not found, using default")
            return ThemeLoader.strip_border_radius(ThemeLoader.DEFAULT_CSS)
        
        user_theme_dir = Path.home() / '.config' / 'volbar' / 'themes'
        user_css_file = user_theme_dir / f'{theme_name}.css'
        
        system_theme_dir = Path('/usr/local/share/volbar/themes')
        system_css_file = system_theme_dir / f'{theme_name}.css'
        
        user_theme_dir.mkdir(parents=True, exist_ok=True)
        
        if user_css_file.exists():
            css_content = user_css_file.read_text()
        elif system_css_file.exists():
            css_content = system_css_file.read_text()
        else:
            css_content = ThemeLoader.DEFAULT_CSS
            if theme_name == 'default':
                user_css_file.write_text(css_content)
                print(f"Created default theme: {user_css_file}")
        
        return ThemeLoader.strip_border_radius(css_content)


