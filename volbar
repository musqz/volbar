def list_sliders():
    """List available slider styles"""
    print("Available slider styles:\n")
    volume = 50
    blocks = volume // 10
    
    for name, slider_func in SLIDERS.items():
        slider = slider_func(blocks)
        print(f"  {name:<15} {slider}")
    
    print(f"\nUsage: volbar --show --slider SLIDER_NAME")
    print(f"Example: volbar --show --slider line")


def list_themes():
    """List available themes"""
    user_theme_dir = Path.home() / '.config' / 'volbar' / 'themes'
    system_theme_dir = Path('/usr/local/share/volbar/themes')
    
    themes = set()
    if user_theme_dir.exists():
        themes.update([f.stem for f in user_theme_dir.glob('*.css') if not f.name.startswith('.')])
    if system_theme_dir.exists():
        themes.update([f.stem for f in system_theme_dir.glob('*.css') if not f.name.startswith('.')])
    
    auto_available = ThemeLoader.CONKY_PATH.exists()
    
    if not themes and not auto_available:
        print("No themes found. Run 'volbar --show' to create default theme.")
        return
    
    themes = sorted(themes)
    print("Available themes:")
    
    if auto_available:
        print(f"  • {'auto':<20} [wallpaper colors]")
    
    for theme in themes:
        location = "user" if (user_theme_dir / f'{theme}.css').exists() else "system"
        print(f"  • {theme:<20} [{location}]")
    
    print(f"\nUser themes:   {user_theme_dir}")
    print(f"System themes: {system_theme_dir}")


def test_themes(args):
    """Test all available themes"""
    user_theme_dir = Path.home() / '.config' / 'volbar' / 'themes'
    system_theme_dir = Path('/usr/local/share/volbar/themes')
    
    themes = set()
    if user_theme_dir.exists():
        themes.update([f.stem for f in user_theme_dir.glob('*.css') if not f.name.startswith('.')])
    if system_theme_dir.exists():
        themes.update([f.stem for f in system_theme_dir.glob('*.css') if not f.name.startswith('.')])
    
    if ThemeLoader.CONKY_PATH.exists():
        themes.add('auto')
    
    if not themes:
        print("No themes found. Creating default...")
        ThemeLoader.load('default')
        themes = {'default'}
    
    themes = sorted(themes)
    print(f"Testing {len(themes)} themes (3 seconds each)")
    print("Press Ctrl+C to stop\n")
    
    cmd_name, handler = AudioBackend.detect()
    if not handler:
        print("✗ No audio backend found")
        return
    
    volume, muted = handler()
    
    for theme in themes:
        print(f"Showing: {theme}")
        
        window = VolumeWindow(
            size=args['size'], placement=args['placement'],
            show_icon=args['icon'], show_percent=args['percent'],
            slider=args['slider'], theme=theme, debug=args['debug']
        )
        
        window.update(volume, muted)
        window.show_all()
        GLib.timeout_add(3000, lambda: (window.hide(), Gtk.main_quit()))
        
        try:
            Gtk.main()
        except KeyboardInterrupt:
            print("\nStopped.")
            break
        time.sleep(0.5)


def show_once(args):
    """Show volume bar once and exit"""
    cmd_name, handler = AudioBackend.detect()
    if not handler:
        print("✗ No audio backend found (wpctl, pactl, or amixer)")
        sys.exit(1)
    
    volume, muted = handler()
    
    if args['debug']:
        print(f"Backend detected: {cmd_name}, volume: {volume}%, muted: {muted}")
    
    window = VolumeWindow(
        size=args['size'], placement=args['placement'], show_icon=args['icon'],
        show_percent=args['percent'], slider=args['slider'], theme=args['theme'],
        debug=args['debug']
    )
    
    window.show_all()
    while Gtk.events_pending():
        Gtk.main_iteration_do(False)
    
    window.update(volume, muted)
    GLib.timeout_add(args['timeout'], lambda: (window.hide(), Gtk.main_quit()))
    
    try:
        Gtk.main()
    except KeyboardInterrupt:
        window.hide()
        sys.exit(0)


def run_daemon(args):
    """Run as daemon"""
    existing_pid = check_daemon_running()
    if existing_pid:
        print(f"✗ Daemon already running (PID: {existing_pid})")
        sys.exit(1)

    create_pid_file()

    cmd_name, handler = AudioBackend.detect()
    if not handler:
        print("✗ No audio backend found (wpctl, pactl, or amixer)")
        remove_pid_file()
        sys.exit(1)

    window = VolumeWindow(
        size=args['size'], placement=args['placement'], show_icon=args['icon'],
        show_percent=args['percent'], slider=args['slider'], theme=args['theme'],
        debug=args['debug']
    )

    # State variables to detect changes
    state = {'volume': -1, 'muted': None}

    def check_volume():
        vol, muted = handler()
        # Only update GUI if values actually changed
        if vol != state['volume'] or muted != state['muted']:
            state['volume'] = vol
            state['muted'] = muted
            window.update(vol, muted)
            if not window.is_visible():
                window.show_all()
                # Hide window after configured timeout
                GLib.timeout_add(args['timeout'], hide_window)
        return True

    def hide_window():
        window.hide()
        return False

    # Start the polling loop
    GLib.timeout_add(args['poll_interval'], check_volume)

    tray = None
    if args['systray']:
        tray = TrayIcon(handler, window, args['tray_step'], args['mixer'], cleanup_and_exit)

    def cleanup_and_exit(tray_icon=None):
        remove_pid_file()
        if tray_icon:
            tray_icon.cleanup()
        Gtk.main_quit()

    signal.signal(signal.SIGTERM, lambda sig, frame: cleanup_and_exit(tray))
    signal.signal(signal.SIGINT, lambda sig, frame: cleanup_and_exit(tray))

    print(f"✓ Volbar daemon started (PID: {os.getpid()})")
    
    try:
        Gtk.main()
    except KeyboardInterrupt:
        cleanup_and_exit(tray)


def parse_arguments():
    """Parse command line arguments using argparse"""
    parser = argparse.ArgumentParser(description=f"Volbar v{get_version()} - Simple X11 Volume Bar", 
                                     epilog="Note: Corner rounding should be configured via picom compositor settings.")
    
    parser.add_argument('--size', choices=['small', 'medium', 'large'], default='medium', help="Size preset (default: medium)")
    parser.add_argument('--placement', choices=PLACEMENTS.keys(), default='center', help="Window placement (default: center)")
    
    parser.add_argument('--no-icon', dest='icon', action='store_false', help="Hide volume icon")
    parser.add_argument('--no-percent', dest='percent', action='store_false', help="Hide percentage text")
    
    parser.add_argument('--slider', choices=SLIDERS.keys(), default='blocks', help="Slider style (default: blocks)")
    parser.add_argument('--theme', default='default', help="Theme name or 'auto' for wallpaper colors (default: default)")
    
    parser.add_argument('--timeout', type=int, default=2000, help="Display timeout in ms (default: 2000)")
    parser.add_argument('--poll-interval', type=int, default=200, help="Volume check interval for daemon in ms (default: 200)")
    parser.add_argument('--debug', action='store_true', help="Enable debug output")
    
    parser.add_argument('--systray-icon', dest='systray', action='store_true', help="Enable system tray volume control (X11 only)")
    parser.add_argument('--tray-step', type=int, default=5, help="Volume step per scroll (default: 5)")
    parser.add_argument('--mixer', default='pavucontrol', help="Mixer command (default: pavucontrol)")
    
    group = parser.add_mutually_exclusive_group()
    group.add_argument('--start-daemon', action='store_const', dest='mode', const='daemon', help="Start background monitoring daemon")
    group.add_argument('--stop-daemon', action='store_const', dest='mode', const='stop', help="Stop running daemon")
    group.add_argument('--list-themes', action='store_const', dest='mode', const='list_themes', help="List available themes")
    group.add_argument('--list-sliders', action='store_const', dest='mode', const='list_sliders', help="List available slider styles")
    group.add_argument('--test-themes', action='store_const', dest='mode', const='test_themes', help="Preview all themes")
    group.add_argument('--show', action='store_const', dest='mode', const='show', help="Show volume once and exit (default)")
    
    parser.set_defaults(mode='show', icon=True, percent=True)
    return vars(parser.parse_args())


def main():
    args = parse_arguments()
    
    if args['mode'] == 'stop':
        stop_daemon()
    elif args['mode'] == 'list_themes':
        list_themes()
    elif args['mode'] == 'list_sliders':
        list_sliders()
    elif args['mode'] == 'test_themes':
        test_themes(args)
    elif args['mode'] == 'daemon':
        run_daemon(args)
    else:
        show_once(args)


if __name__ == '__main__':
    main()
