def get_version():
    """Get version from version.txt or fallback to hardcoded"""
    version_paths = [
        Path(__file__).parent / 'version.txt',
        Path('/usr/local/share/volbar/version.txt'),
        Path('/usr/share/volbar/version.txt'),
    ]
    for p in version_paths:
        if p.exists():
            return p.read_text().strip()
