def list_themes():
    """List available themes"""
    user_theme_dir = Path.home() / '.config' / 'volbar' / 'themes'
    system_theme_dir = Path('/usr/local/share/volbar/themes')
    
    themes = set()
    
    if user_theme_dir.exists():
        # Exclude dotfiles (like .auto)
        themes.update([f.stem for f in user_theme_dir.glob('*.css') if not f.name.startswith('.')])
    
    if system_theme_dir.exists():
        themes.update([f.stem for f in system_theme_dir.glob('*.css') if not f.name.startswith('.')])
    
    # Check if auto theme is available
    auto_available = ThemeLoader.CONKY_PATH.exists()
    
    if not themes and not auto_available:
        print("No themes found. Run 'volbar --show' to create default theme.")
        return
    
    themes = sorted(themes)
    
    print("Available themes:")
    
    # Show auto theme first if available
    if auto_available:
        print(f"  • {'auto':<20} [wallpaper colors]")
    
    for theme in themes:
        if (user_theme_dir / f'{theme}.css').exists():
            location = "user"
        else:
            location = "system"
        print(f"  • {theme:<20} [{location}]")
    
    print(f"\nUser themes:   {user_theme_dir}")
    print(f"System themes: {system_theme_dir}")
    print(f"\nUsage: volbar --show --theme THEMENAME")
    if auto_available:
        print(f"       volbar --show --theme auto  (uses wallpaper colors)")


def test_themes(args):
    """Test all available themes"""
    user_theme_dir = Path.home() / '.config' / 'volbar' / 'themes'
    system_theme_dir = Path('/usr/local/share/volbar/themes')
    
    themes = set()
    if user_theme_dir.exists():
        themes.update([f.stem for f in user_theme_dir.glob('*.css') if not f.name.startswith('.')])
    if system_theme_dir.exists():
        themes.update([f.stem for f in system_theme_dir.glob('*.css') if not f.name.startswith('.')])
    
    # Add auto theme if available
    if ThemeLoader.CONKY_PATH.exists():
        themes.add('auto')
    
    if not themes:
        print("No themes found. Creating default...")
        ThemeLoader.load('default')
        themes = {'default'}
    
    themes = sorted(themes)
    
    print(f"Testing {len(themes)} themes (3 seconds each)")
    print("Press Ctrl+C to stop\n")
    
    backend = AudioBackend.detect()
    if not backend:
        print("✗ No audio backend found")
        return
    
    volume, muted = backend()
    
    for theme in themes:
        print(f"Showing: {theme}")
        
        window = VolumeWindow(
            size=args.get('size', 'large'),
            placement=args.get('placement', 'center'),
            show_icon=args.get('icon', True),
            show_percent=args.get('percent', True),
            slider=args.get('slider', 'blocks'),
            theme=theme,
            debug=args.get('debug', False)
        )
        
        window.update(volume, muted)
        window.show_all()
        
        GLib.timeout_add(3000, lambda: (window.hide(), Gtk.main_quit()))
        
        try:
            Gtk.main()
        except KeyboardInterrupt:
            print("\nStopped.")
            break
        
        time.sleep(0.5)


